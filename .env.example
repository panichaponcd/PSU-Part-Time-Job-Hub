# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Used by both backend (token verification) and frontend (Google Identity Services button)
GOOGLE_CLIENT_ID=475299228364-l82po98oo90bps187qg4lhrdl3633rji.apps.googleusercontent.com
REACT_APP_GOOGLE_CLIENT_ID=475299228364-l82po98oo90bps187qg4lhrdl3633rji.apps.googleusercontent.com

# Optional: Comma-separated list of PSU staff/advisor emails granted ADMIN role on Google Sign-In
ADMIN_EMAILS=

# Keep manual student registration disabled to prevent Student ID impersonation
ALLOW_MANUAL_REGISTRATION=false

# LINE Messaging API (from https://developers.line.biz/)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Target LINE Group ID (bot replies with this ID automatically when invited to a group or via !groupid)
LINE_GROUP_ID=
# Public URL used for "View & Apply" links inside LINE Flex Message cards
PUBLIC_WEB_URL=https://budget-dorm-server.tail6de02b.ts.net
